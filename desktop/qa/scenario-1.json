    {"wait": 5000, "shot": "C1-backtest-vwap-16y"},
    {"eval": "[...document.querySelectorAll('h2')].map(h => h.textContent).find(t => t.includes('Trade ledger'))", "save": "ui_ledger_title"},

    {"nav": "/lab", "settle": 3000},
    {"fill": "Algorithm", "value": "rule"},
    {"fill": "Strategy name", "value": "QA trend continuation NQ"},
    {"fillSel": "[data-qa=cond-0-left]", "value": "close"},
    {"fillSel": "[data-qa=cond-0-op]", "value": "crosses_above"},
    {"fillSel": "[data-qa=cond-0-right]", "value": "vwap"},
    {"fillSel": "[data-qa=cond-1-left]", "value": "adx"},
    {"fillSel": "[data-qa=cond-1-op]", "value": ">"},
    {"fillSel": "[data-qa=cond-1-right]", "value": "__number"},
    {"fillSel": "[data-qa=cond-1-right-num]", "value": "25"},
    {"click": "Add condition", "exact": true},
    {"fillSel": "[data-qa=cond-2-left]", "value": "close"},
    {"fillSel": "[data-qa=cond-2-op]", "value": ">"},
    {"fillSel": "[data-qa=cond-2-right]", "value": "ema"},
