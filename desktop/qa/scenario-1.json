    {"read": "Experiment detail", "save": "ui_detail_expansion", "shot": "B1-model-detail-expansion"},
    {"click": "Save config", "exact": true},
    {"waitText": "Saved QA NQ expansion LGBM", "timeout": 15000},

    {"fill": "Experiment name", "value": "QA NQ TBS long 0.5x0.25 LGBM"},
    {"fill": "Prediction objective", "value": "target_before_stop"},
    {"fill": "Geometry · side (ATR multiples)", "value": "0.5x0.25"},
