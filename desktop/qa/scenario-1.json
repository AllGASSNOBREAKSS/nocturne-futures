    {"waitJob": "QA trend continuation NQ", "expectState": "SUCCEEDED", "save": "job_bt_rule", "timeout": 1700000},
    {"wait": 5000, "shot": "D2-rule-backtest"},

    {"nav": "/lab", "settle": 3000},
    {"fill": "Algorithm", "value": "rule"},
    {"fill": "Strategy name", "value": "QA consolidation breakout ES"},
