    {"fillSel": "[data-qa=cond-0-left]", "value": "close"},
    {"fillSel": "[data-qa=cond-0-op]", "value": "crosses_above"},
    {"fillSel": "[data-qa=cond-0-right]", "value": "bb_upper"},
    {"fillSel": "[data-qa=cond-1-left]", "value": "adx"},
    {"fillSel": "[data-qa=cond-1-op]", "value": "<"},
    {"fillSel": "[data-qa=cond-1-right]", "value": "__number"},
    {"fillSel": "[data-qa=cond-1-right-num]", "value": "20"},
    {"fill": "Targets (R, comma)", "value": "1,2"},
    {"fill": "Start (UTC)", "value": "2019-01-01"},
    {"fill": "Data source", "value": "databento"},
    {"click": "Save version", "exact": true},
    {"waitText": "Saved QA consolidation breakout ES", "timeout": 15000},
    {"click": "Backtest", "exact": true},
    {"waitJob": "QA consolidation breakout ES", "expectState": "SUCCEEDED", "save": "job_bt_consolidation", "timeout": 1700000},

    {"nav": "/signals", "settle": 6000, "shot": "E1-signals"},
    {"nav": "/predictions", "settle": 4000},
    {"click": "Issue next-session forecast", "exact": true},
    {"waitText": "outcomes evaluated", "timeout": 120000, "shot": "F1-prediction-issued"},
    {"api": {"path": "/v1/forecasts/sessions?root=NQ"}, "save": "api_forecasts_nq"},
    {"nav": "/performance", "settle": 4000, "shot": "P1-performance"},
    {"nav": "/intel", "settle": 4000, "shot": "I1-intel"},
    {"nav": "/ops", "settle": 5000, "shot": "O1-ops"},

    {"api": {"method": "POST", "path": "/v1/backtests", "body": {"root": "XX"}}, "save": "j_invalid_backtest"},
    {"api": {"path": "/v1/markets/NQ/bars?interval=7m"}, "save": "j_bad_interval", "expectError": true},
    {"api": {"path": "/v1/backtests/ffffffffffffffffffffffff"}, "save": "j_missing_job", "expectError": true},

    {"nav": "/models", "settle": 3000},
    {"click": "DATABENTO 2010–2026", "exact": true},
    {"fill": "Experiment name", "value": "QA interrupted by restart"},
    {"fill": "Prediction objective", "value": "direction"},
    {"fill": "Model family", "value": "random_forest"},
    {"fill": "Trees", "value": "3000"},
