    {"waitJob": "QA NQ TBS long 0.5x0.25 LGBM", "expectState": "SUCCEEDED", "save": "job_ml_tbs"},
    {"click": "QA NQ TBS long 0.5x0.25 LGBM", "within": "Experiments", "wait": 4000, "shot": "B2-model-detail-tbs"},

    {"fill": "First test yr", "value": "1990"},
    {"click": "Start training", "exact": true},
    {"waitText": "test years must satisfy", "timeout": 15000, "shot": "J1-invalid-config-error"},
    {"fill": "First test yr", "value": "2012"},

    {"fill": "Experiment name", "value": "QA cancel RF"},
    {"fill": "Prediction objective", "value": "direction"},
    {"fill": "Model family", "value": "random_forest"},
    {"fill": "Trees", "value": "2000"},
    {"click": "rates credit", "within": "Feature families (point-in-time)"},
    {"click": "positioning", "within": "Feature families (point-in-time)"},
    {"click": "Start training", "exact": true, "wait": 6000},
