    {"fill": "Model family", "value": "lightgbm"},
    {"click": "intraday", "within": "Feature families (point-in-time)"},
    {"click": "Start training", "exact": true},
    {"waitJob": "QA NQ expansion LGBM", "expectState": "SUCCEEDED", "save": "job_ml_expansion"},
